---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import CommentBox from '../../components/CommentBox.astro';
import { sitePath, postPath } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(entry => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allPosts = (await getCollection('posts', ({ data }) => data.kind === 'article'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));
const currentIndex = allPosts.findIndex(post => post.id === entry.id);
const previous = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
const related = allPosts.filter(post => post.id !== entry.id && post.data.category === entry.data.category).slice(0, 3)
  .map(post => ({ title: post.data.title, category: post.data.category, url: postPath(post.data.slug) }));
const toc = entry.data.kind === 'article' ? headings.filter(item => item.depth === 2 || item.depth === 3) : [];
---
<SiteLayout title={entry.data.title} description={entry.data.summary} toc={toc} hasAside={entry.data.kind === 'article'}>
  <header class="article-header">
    <nav class="breadcrumb"><a href={sitePath('')}>首页</a><span>/</span><a href={sitePath('archives/')}>归档</a><span>/</span><span>{entry.data.category}</span></nav>
    <h1>{entry.data.title}</h1>
    {entry.data.summary && <p class="article-summary">{entry.data.summary}</p>}
    <div class="article-meta"><span><i class="fa fa-folder-o"></i>{entry.data.category}</span><span><i class="fa fa-calendar-o"></i>日期未记录</span>{entry.data.tags.map(tag => <a class="tag-chip" href={sitePath('tags/' + encodeURIComponent(tag) + '/')}>{tag}</a>)}</div>
  </header>
  <article class="post-prose"><Content /></article>
  {(previous || next) && <nav class="article-nav" aria-label="上一篇和下一篇">
    {previous ? <a href={postPath(previous.data.slug)}><small>上一篇</small><strong>{previous.data.title}</strong></a> : <span></span>}
    {next ? <a href={postPath(next.data.slug)}><small>下一篇</small><strong>{next.data.title}</strong></a> : <span></span>}
  </nav>}
  {entry.data.kind === 'article' && <CommentBox pathname={Astro.url.pathname} />}
  {entry.data.kind === 'article' && <ArticleAside slot="aside" related={related} />}
</SiteLayout>
